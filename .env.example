HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
DATA_DIR=/data
# Compose publishes to loopback unless this is explicitly set to a trusted interface address.
CODEX_GATEWAY_BIND_ADDRESS=127.0.0.1
CODEX_GATEWAY_PORT=11435
FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your-firebase-web-app-id
FIREBASE_ADMIN_EMAIL=you@example.com
# Optional comma-separated Google accounts approved to operate this gateway.
FIREBASE_ALLOWED_EMAILS=
