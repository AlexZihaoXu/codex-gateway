{
  "name": "codex-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "A local OpenAI-compatible gateway backed by Codex.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.6",
  "engines": {
    "bun": ">=1.3.6"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "scripts": {
    "audit": "bun run audit:web && bun run audit:go",
    "audit:go": "bun scripts/audit-go.ts",
    "audit:web": "bun audit",
    "build": "bun run clean && bun run build:web && bun run build:go",
    "build:go": "go build -buildvcs=false -tags production -o build/ ./cmd/gateway",
    "build:web": "vite build --config web/vite.config.ts",
    "clean": "bun scripts/clean.ts",
    "dev": "concurrently --kill-others --names api,web --prefix-colors cyan,magenta \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "go run -buildvcs=false ./cmd/gateway",
    "dev:web": "vite --config web/vite.config.ts",
    "format": "gofmt -w cmd internal && prettier --write .",
    "format:check": "bun scripts/check-format.ts",
    "lint": "bun run lint:go && bun run lint:web",
    "lint:go": "go vet ./...",
    "lint:web": "eslint web scripts --max-warnings=0",
    "mcp:heroui": "bun node_modules/@heroui/react-mcp/dist/stdio.js",
    "mcp:heroui:check": "bun scripts/check-heroui-mcp.ts",
    "prepare": "husky",
    "test": "bun run test:go && bun run test:web && bun run test:compose",
    "test:compose": "bun scripts/check-compose.ts",
    "test:container": "bun scripts/test-dev-container.ts",
    "test:go": "bun scripts/test-go.ts",
    "test:web": "vitest run --coverage --config web/vitest.config.ts --maxWorkers=1",
    "test:watch": "vitest --config web/vitest.config.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "lint-staged": {
    "*.go": "gofmt -w",
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.18.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "rehype-highlight": "^7.0.2",
    "rehype-mathjax": "^7.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "swagger-ui-dist": "5.32.14",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@heroui/react-mcp": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
